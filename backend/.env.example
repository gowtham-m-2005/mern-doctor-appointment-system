# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://localhost:27017/doctor-appointment

# Redis Configuration
# Option 1: Use individual host/port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Option 2: Use Redis URL (preferred for cloud Redis like Redis Cloud, AWS ElastiCache)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@host:port

# JWT Configuration (HIPAA Compliant)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_this_in_production

# Encryption Key (for sensitive data encryption - HIPAA Compliant)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_encryption_key_in_hex_format

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=Doctor Appointment System <noreply@doctorapp.com>

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.pdf,.jpg,.jpeg,.png

# Session Configuration (HIPAA Compliant)
SESSION_TIMEOUT=1800000
MAX_SESSION_DURATION=28800000

# Rate Limiting (HIPAA Compliant)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=3

# Security Headers (HIPAA Compliant)
ENABLE_HTTPS=true
ENABLE_HSTS=true

# Audit Logging (HIPAA Compliant)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
